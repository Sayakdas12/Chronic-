# Server
PORT=3000
NODE_ENV=development

# High-availability process settings (used by local/server deployments)
HA_WORKERS=2
HA_HEARTBEAT_MS=2000
HA_HEARTBEAT_TIMEOUT_MS=7000
HA_MAX_RSS_MB=768

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
ADMIN_NOTIFICATION_EMAIL=
GOVERNMENT_ADMIN_EMAIL=

# Firebase Admin shared OTP storage (Render environment variables)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}
# Local development only; never enable this in production.
# ALLOW_LOCAL_ADMIN_BYPASS=true
# Or use a local/secret-mounted service-account file:
# FIREBASE_SERVICE_ACCOUNT_FILE=D:\path\to\service-account.json
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_EXPIRY_MINUTES=10

# Optional SMS OTP provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email provider: auto, resend, brevo, or smtp
EMAIL_PROVIDER=auto
EMAIL_FROM=ChronicAI <no-reply@your-verified-domain.example>
EMAIL_FROM_NAME=ChronicAI

# Brevo transactional email
BREVO_API_KEY=
BREVO_FROM=no-reply@your-verified-domain.example

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM=ChronicAI <no-reply@your-verified-domain.example>

# SMTP fallback, including Gmail app-password authentication
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Backward-compatible aliases supported by the fallback
EMAIL_USER=
EMAIL_PASSWORD=
