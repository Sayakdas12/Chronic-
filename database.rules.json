{
  "rules": {
    ".read": false,
    ".write": false,
    "otpChallenges": {
      ".indexOn": ["expiresAt"]
    },
    "verifiedOtpTokens": {
      ".indexOn": ["expiresAt"]
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && newData.child('role').val() === 'citizen') || (data.exists() && newData.child('role').val() === data.child('role').val()))) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".write": false
        }
      }
    },
    "missingPersons": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator', 'viewer']",
      "$personId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator', 'viewer'] || data.child('reporterUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator'] || (!data.exists() && newData.child('reporterUid').val() === auth.uid && newData.child('approved').val() === false && newData.child('status').val() === 'Pending'))",
        ".validate": "newData.hasChildren(['name','age','location','lastSeenDate','details','status','approved','reporterUid','createdAt']) && newData.child('name').isString() && newData.child('details').isString() && newData.child('status').val() in ['Pending','Active','Found','Closed']",
        "reporterUid": { ".write": "!data.exists()" },
        "approved": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" },
        "status": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" }
      }
    },
    "missingPublic": {
      ".read": "auth != null",
      "$personId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator'] || ((!data.exists() || data.child('reporterUid').val() === auth.uid) && newData.child('reporterUid').val() === auth.uid))"
      }
    },
    "missingTips": {
      "$personId": {
        "$tipId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['message','anonymous','status','createdAt']) && newData.child('message').isString() && newData.child('message').val().length <= 1500"
        }
      }
    },
    "riskWatch": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rescueVehicles": {
      ".read": "auth != null",
      "$vehicleId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator']",
        ".validate": "newData.hasChildren(['agency','type','latitude','longitude','status','lastUpdated']) && newData.child('agency').isString() && newData.child('type').isString() && newData.child('latitude').isNumber() && newData.child('longitude').isNumber() && newData.child('status').val() in ['AVAILABLE','ASSIGNED','EN_ROUTE','ON_EMERGENCY_MISSION','ARRIVED','COMPLETED','OFFLINE']"
      }
    },
    "emergencyRequests": {
      "$incidentId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator', 'viewer'])",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator'])",
        ".validate": "newData.hasChildren(['userId','latitude','longitude','emergencyType','status','createdAt','updatedAt']) && newData.child('userId').isString() && newData.child('latitude').isNumber() && newData.child('longitude').isNumber() && newData.child('emergencyType').isString() && newData.child('status').val() in ['PENDING','ASSIGNED','EN_ROUTE','ARRIVED','COMPLETED','CANCELLED']"
      }
    },
    "supportRequests": {
      "$requestId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator', 'viewer'])",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'super_admin', 'government_officer', 'rescue_coordinator']",
        ".validate": "newData.hasChildren(['requestId','category','userId','personalInfo','status','submittedAt']) && newData.child('category').val() in ['financial_donation','resource_donation','civic_volunteer'] && newData.child('status').val() in ['pending','under_review','approved','contacted','completed','rejected','archived']"
      }
    }
  }
}
